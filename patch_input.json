  "diff_articulation": {
    "what_changed": [
      "Added RiskLevel.INCONCLUSIVE and exit code 3, distinct from RED exit 2",
      "Added scan_integrity evaluation in the runner, not in compute_confidence",
      "Bumped run_result schema to run_result_v2 with nullable confidence and optional scan_integrity",
      "A missing parser on eligible JS/TS files is missing_capability and cannot be GREEN",
      "Non-critical degradation caps GREEN at YELLOW and every tier discloses degraded coverage",
      "PR-CLEAN appends structured degraded evidence beside the existing skipped warning text",
      "Removed pytest --maxfail=1 and locked the debt CLI --ci/--out contract",
      "Bumped signal_logic_version to signals_v6 and refreshed golden fixtures and contract manifests"
    ],
    "why_not_redundant": "The scorer only sees findings, so an empty or crashed scan previously scored 83 and exited 0. The guard has to live where the runner knows which analyzers finished."
  },
